{
  "name": "tank-me",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "oxfmt src/",
    "emulators": "firebase emulators:start --import ./emulatorstate --export-on-exit ./emulatorstate"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "dependencies": {
    "colyseus.js": "^0.16.22",
    "firebase": "^12.17.1",
    "pinia": "^4.0.2",
    "showdown": "^2.1.0",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@babylonjs/core": "^9.20.0",
    "@babylonjs/havok": "^1.3.14",
    "@babylonjs/inspector": "^9.20.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.13.3",
    "@types/showdown": "^2.0.6",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "canvas": "^3.2.3",
    "cheerio": "^1.2.0",
    "domhandler": "^6.0.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.75.0",
    "eslint-plugin-vue": "~10.9.2",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.2",
    "oxfmt": "^0.59.0",
    "oxlint": "~1.75.0",
    "rolldown": "^1.2.3",
    "typescript": "~6.0.0",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.7"
  }
}
